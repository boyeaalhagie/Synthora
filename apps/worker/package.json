{
  "name": "@synthora/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../web/dist',{recursive:true})\" && wrangler d1 migrations apply synthora --local && wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx eval/run.ts",
    "db:migrate:local": "wrangler d1 migrations apply synthora --local",
    "db:migrate:remote": "wrangler d1 migrations apply synthora --remote",
    "research": "tsx cli/research.ts",
    "build:cli": "esbuild cli/research.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-cli/research.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@google/genai": "^3.4.0",
    "@synthora/schemas": "*",
    "fast-xml-parser": "^5.12.1",
    "openai": "^7.57.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.0.0"
  }
}
